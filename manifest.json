{
  "manifest_version": 3,
  "name": "ASCII Animals",
  "version": "0.1.3",
  "description": "Animated ASCII animals on every new Firefox tab.",
  "permissions": ["storage", "search", "topSites"],
  "chrome_url_overrides": { "newtab": "index.html" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "action": {
    "default_area": "navbar",
    "default_icon": "icon.svg",
    "default_title": "ASCII Animals settings",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ascii-animals@extension.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
